# KORA — variables d'environnement (développement)
# Copier vers .env — ne JAMAIS committer de secrets réels.

# Connexion migrations/seed (propriétaire du schéma — jamais utilisée par l'application)
DATABASE_URL_MIGRATOR=postgres://kora_migrator:kora_migrator_dev@127.0.0.1:5432/kora

# Connexion applicative (NOBYPASSRLS — toute requête est bornée au tenant courant)
DATABASE_URL_APP=postgres://kora_app:kora_app_dev@127.0.0.1:5432/kora

# Clé de scellement des secrets MFA (AES-256-GCM) : 32 octets en hex (64 caractères)
# ou base64. OBLIGATOIRE au démarrage de l'API — générer : openssl rand -hex 32
KORA_MFA_KEY=remplacer_par_64_caracteres_hex

# Limitation de débit du login (fenêtre glissante, en mémoire) — défauts raisonnables
#KORA_LOGIN_RATE_WINDOW_MS=60000
#KORA_LOGIN_RATE_IDENTITY_MAX=10
#KORA_LOGIN_RATE_IP_MAX=100

# Vérification des mots de passe compromis :
#   off   (défaut) : politique locale @kora/core seule
#   local : idem (la liste embarquée fait foi)
#   hibp  : API pwnedpasswords par k-anonymat (le mot de passe ne sort jamais)
#KORA_BREACH_CHECK=off
# En mode hibp, comportement si l'API est injoignable : open (défaut, ne bloque pas)
# ou closed (refuse le changement — 503). La politique locale s'applique dans tous les cas.
#KORA_BREACH_FAIL=open

# Notification Engine (E5) — réglages OPÉRATIONNELS de la file de livraison (pas des
# paramètres légaux : ils ne passent donc pas par le Config Center). Transport des
# canaux sortants (email/sms/push) : SIMULÉ tant qu'aucun fournisseur n'est
# contractualisé — aucun envoi réel, marqueurs d'échec déterministes pour les tests.
#KORA_NOTIFY_MAX_ATTEMPTS=5          # tentatives avant dead_letter (1..20)
#KORA_NOTIFY_BACKOFF_BASE_MS=60000   # délai après le 1er échec
#KORA_NOTIFY_BACKOFF_FACTOR=2        # multiplicateur exponentiel
#KORA_NOTIFY_BACKOFF_MAX_MS=3600000  # plafond du délai entre tentatives
